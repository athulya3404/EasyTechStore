# ==============================================================================
# EasyTech Store - Environment Variables Template (.env.example)
# Copy this file to .env and configure appropriate values for your environment.
# ==============================================================================

# General Django Settings
DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_DEBUG=True
DJANGO_SECRET_KEY=replace-with-a-secure-random-secret-key-in-production
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database Configuration (PostgreSQL)
# Either DATABASE_URL or POSTGRES_* credentials
DATABASE_URL=postgres://postgres:postgres@localhost:5432/easytechstore
POSTGRES_DB=easytechstore
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Email Configuration (SMTP)
DJANGO_EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL="EasyTech Store <noreply@easytechstore.com>"

# AI Chatbot (Ollama & ChromaDB RAG)
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_FALLBACK_MODEL=llama3.2
OLLAMA_TIMEOUT=8.0
CHROMA_PERSIST_DIR=./data/chroma_db

# Security & CORS (Production)
DJANGO_SECURE_SSL_REDIRECT=False
DJANGO_SESSION_COOKIE_SECURE=False
DJANGO_CSRF_COOKIE_SECURE=False
